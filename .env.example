# ── Echo environment ────────────────────────────────────────────────────────
# Copy to .env and fill in. On Vercel, set these as Project → Environment Variables.

# PostgreSQL connection string.
# Free option: create a database at https://neon.tech and paste its URL here.
# (Vercel Postgres works too — it injects this automatically.)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (non-pooled) connection — used only by `prisma db push` / migrations.
# On Vercel+Neon this is set for you. Locally, set it to the same value as
# DATABASE_URL (or your DB's direct/unpooled URL).
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session cookies. Generate one with:  openssl rand -hex 32
AUTH_SECRET="please-generate-a-long-random-string"

# Public base URL of your deployment (used to build verification/reset links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Vercel Blob read/write token for media uploads (Vercel → Storage → Blob).
# Leave blank for local dev — uploads then fall back to /public/uploads on disk.
BLOB_READ_WRITE_TOKEN=""

# When true, email verification / password-reset links print to the server
# console instead of being emailed (no SMTP needed).
DEV_EMAIL_TO_CONSOLE="true"
